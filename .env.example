# Multi-user mode is disabled by default. Enable only after migration and testing.
# MULTI_USER_ENABLED=false

# Optional local PostgreSQL URL for integration tests.
# Use a disposable local database only; never use a production or hosted URL.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Runtime configuration (set actual values privately).
# DATABASE_URL=
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
EMAIL_FROM=JobTrail HK <jobtrialhk@gmail.com>

# Gmail API only. Configure EXACTLY ONE source for authorized-user token JSON.
# This is gmail_token.json from setup, NOT the OAuth client credentials.json.
# Prefer an absolute path outside the repository or a mounted secret file.
# GMAIL_TOKEN_FILE=
# Alternative: the full token JSON in a private hosting secret, never in Git.
# GMAIL_TOKEN_JSON=
